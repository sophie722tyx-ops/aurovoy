{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aurovoy",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "routes": [
    {"pattern": "aurovoy.cn", "custom_domain": true},
    {"pattern": "www.aurovoy.cn", "custom_domain": true}
  ],
  "preview_urls": false,
  "keep_vars": true,
  "secrets": {
    "required": ["ADMIN_EMAIL", "ACCESS_TEAM_DOMAIN", "ACCESS_AUD"]
  },
  "build": {
    "command": "node build-worker.mjs"
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": false,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aurovoy-db",
      "database_id": "7d1eb63f-d232-4ad1-b2f3-5e51c2d3f154",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "aurovoy-files"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
