{
  "name": "aurovoy-site",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node build-worker.mjs",
    "dev": "wrangler dev",
    "test": "node build-worker.mjs && node --test backend.test.mjs auth.test.mjs migration.test.mjs",
    "test:runtime": "node build-worker.mjs && node verify-bundle.mjs && node runtime-smoke.mjs",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "jose": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "esbuild-wasm": "0.28.1",
    "wrangler": "^4.0.0"
  }
}
